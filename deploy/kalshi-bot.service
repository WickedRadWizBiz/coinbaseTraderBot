# /etc/systemd/system/kalshi-bot.service
# deploy/activate.sh installs this with the server's own user, home and node path filled in.
# Runs the bot as an unprivileged user from ~/bot/current with the server's
# own environment file (~/bot/bot.env, created on first deploy). By default the dashboard is open
# on the static IP (http://<host>:3000, BIND_HOST=0.0.0.0). To lock it down, see docs/DEPLOY.md:
#   BIND_HOST=127.0.0.1 and reach it via  ssh -L 3000:127.0.0.1:3000 ubuntu@<host>  (or Tailscale)
[Unit]
Description=Kalshi 15m crypto bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot/current
EnvironmentFile=/home/ubuntu/bot/bot.env
Environment=DATA_DIR=/home/ubuntu/bot/data
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/bot.cjs
Restart=on-failure
RestartSec=10
# A config error exits with code 2/3: do not restart-loop on it.
RestartPreventExitStatus=2 3
KillSignal=SIGTERM
# Shutdown cancels resting orders and checkpoints the SNNs: give a busy small server time to finish.
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/bot
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
