# Copy to .env for local runs, or /home/ubuntu/bot/bot.env on the server.
# Every value is read ONCE at startup and frozen. There is no API to change
# any of these at runtime; changing one means editing this file and restarting.

# ---- Mode -----------------------------------------------------------------
# paper  : simulated exchange, public REST market data (+ optional proxy index)
# shadow : simulated exchange, authenticated Kalshi WebSocket data incl. CF RTI
# live   : real orders. Also requires KALSHI_ENV=prod, the acknowledgement
#          below, and a validated model file (params/model.json).
TRADING_MODE=paper
KALSHI_ENV=demo
# LIVE_TRADING_ACKNOWLEDGED=I_ACCEPT_REAL_MONEY_RISK

# ---- Credentials (use a NEW, subaccount-restricted key; rotate the old one) --
# The private key must live OUTSIDE the repo with permissions 600.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/.kalshi/private_key.pem
# KALSHI_SUBACCOUNT=1
# Fee rounding grid: 0.01 for non-direct (FCM-cleared) members, 0.0001 for direct members.
KALSHI_BALANCE_PRECISION=0.01
# Trade binary contracts live even when the model failed validation (every other limit still applies).
# LIVE_ALLOW_UNVALIDATED_MODEL=true
# Unvalidated models trade on probation and are benched when their book's results are unacceptable
# (README "Probation"); enforce = every validation gate blocks.
VALIDATION_GATES=monitor
# PROBATION_MIN_TRADES=20
# PROBATION_T=1
# Benched at a net loss of PROBATION_MAX_LOSS_USD, or PROBATION_MAX_LOSS_PCT of the book's break-even when smaller
# (15% of a $41 account is $6.18; a $400 account keeps $25).
# PROBATION_MAX_LOSS_USD=25
# PROBATION_MAX_LOSS_PCT=0.15
# PROBATION_WINDOW=200
# Exit-in-profit curve on binary contracts (README "Exit-in-profit curve"): gate = a profit-taking exit also needs
# the curve's signal (a spike above it or a roll-over below its projection); monitor = show it, never hold; off.
SINUOUS_EXIT=gate
# Net profit a contract (cents, after fees) an exit must clear to count as a profit exit; smaller gains go out as before.
# SINUOUS_MIN_PROFIT_CENTS=1.5
# Entry curve (README "Entry curve"): monitor = score maker entries by the book's curve when they filled (60 s markout of
# the fills it would have blocked vs kept), never block; gate = no quote that adds to a position while the curve runs
# against its side faster than SINUOUS_ENTRY_SLOPE_CENTS a 10 seconds (a resting one is pulled); off.
SINUOUS_ENTRY=monitor
# SINUOUS_ENTRY_SLOPE_CENTS=0.5

# ---- Operator API -----------------------------------------------------------
# Optional dashboard login. Empty = the dashboard opens without one.
DASHBOARD_PASSWORD=
BIND_HOST=127.0.0.1
PORT=3000

# ---- Data ---------------------------------------------------------------------
DATA_DIR=./data
MODEL_PARAMS_PATH=./params/model.json
PAPER_BANKROLL_USD=100
# Hard floor: no new risk below this tradable bankroll (exits still run).
MIN_TRADABLE_BANKROLL_USD=10
# Bankroll-scaled risk tiers, chosen from the tradable high-water mark and interpolated in between:
#   $20 aggressive (10%/order, 20% daily stop, 3/4 Kelly) -> $50 moderate (5%, 10%, 1/2 Kelly)
#   -> $100 normal (the RISK_* / STRATEGY_KELLY_FRACTION values below). Unset = this ladder;
#   "off" = normal limits at every size; or a JSON array of tier points (see bot/risk/sizingTiers.ts).
SIZING_TIERS=
# Ignore markets closing further out than this (daily/weekly strikes of hourly series).
CATALOG_HORIZON_MIN=90
# Operator-maintained macro calendar for the calendar features (see params/calendar.example.json).
MACRO_CALENDAR_PATH=./params/calendar.json
# Paper only: price off Coinbase spot when no authenticated RTI feed (basis risk).
ALLOW_PROXY_INDEX=false
# Settlement average: official = sixty one-per-second RTI values (Kalshi's rule); continuous = time-weighted.
SETTLEMENT_AVG=official
# Clock-skew guard: the local clock is compared with the Date header of every Kalshi response. New risk
# halts when it is confidently off by more than MAX (exits stay allowed); 0 disables. Warn is dashboard-only.
CLOCK_SKEW_MAX_MS=2000
CLOCK_SKEW_WARN_MS=1000
# Stream Coinbase spot (public) for lead-lag features and the dashboard depth view.
SPOT_FEED=true
# TA library (bot/ta): Coinbase spot candles (1m, 5m, 15m, 1h, 1d; 4h built from 1h) for every asset.
# Recorded, so replay/training see the same candles. TA_STUDY_PATH is the output of `npm run research:ta`.
TA_CANDLES=true
COINBASE_REST_URL=https://api.exchange.coinbase.com
TA_STUDY_PATH=./params/ta_study.json
# USDT.D / BTC.D: Binance prices anchored to CoinGecko (feature inputs only).
# Binance.com blocks US IPs; the market-data-only host below usually works.
DOMINANCE_FEED=true
BINANCE_WS_URL=wss://data-stream.binance.vision/ws/!miniTicker@arr
COINGECKO_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ---- Strategy -----------------------------------------------------------------
# 15-minute Up/Down and/or hourly ladders (KXBTCD, KXETHD, KXSOLD) and brackets (KXBTC, KXETH).
# auto (default): every crypto 15-minute Up/Down, hourly ladder and range series Kalshi lists whose asset
# has a settlement index in INDEX_ID_MAP (BTC, ETH, SOL, XRP, DOGE), re-discovered hourly.
# Or an explicit comma list, e.g. KXBTC15M,KXETH15M,KXBTCD.
STRATEGY_SERIES=auto
# Record-only series: comma list of Kalshi series tickers whose books, trades, lifecycle and official
# results are RECORDED for research (new datasets, other sports, markets the pricer can't value) but are
# never priced, quoted or traded. Capped at RECORD_MAX_MARKETS concurrently tracked markets.
RECORD_SERIES=
RECORD_MAX_MARKETS=150
STRATEGY_STYLE=maker
# relaxed (spec): decide on each 1-minute bar close or on a trigger; continuous: every tick.
STRATEGY_CADENCE=relaxed
STRATEGY_EVAL_BAR_SEC=60
STRATEGY_EVAL_FV_MOVE=0.015
# A resting quote is looked at again this often (also after it expired, filled or was pulled).
STRATEGY_REPRICE_SEC=10
STRATEGY_MIN_EVAL_INTERVAL_SEC=10
# Entry windows "earliest,latest" seconds before close; hourly strikes only inside the mid band. No new 15-minute
# entries in the last 5 minutes or hourly ones in the last 10, so a position has time to sell before the final minute.
ENTRY_WINDOW_15M=840,300
ENTRY_WINDOW_HOURLY=3300,600
HOURLY_MID_BAND=0.1,0.9
# Positions still open this close to settlement ride to settlement.
STRATEGY_NO_EXIT_BEFORE_CLOSE_SEC=60
STRATEGY_KELLY_FRACTION=0.25
# e_min for maker entries; taker entries need STRATEGY_MIN_EDGE + STRATEGY_TAKER_BUFFER (5c).
STRATEGY_MIN_EDGE=0.03
STRATEGY_TAKER_BUFFER=0.02
# Adverse-selection buffer for maker bids (default until 30 maker fills, then the measured 60 s markout, clamped
# to the range): the discount asked for the move against a fill.
STRATEGY_MAKER_BUFFER=0.02
STRATEGY_MAKER_BUFFER_RANGE=0.015,0.03
# Smallest maker quote in contracts when sizing wants a smaller one, within the per-order caps and the risk room
# left (Kalshi rounds each order's fee up to the cent, so small positions pay more a contract to sell). 0 = off.
STRATEGY_MIN_QUOTE_CONTRACTS=3
# target_ev: q_adj = p_mkt_cal + kappa (p_model - p_mkt_cal); N = min(ceil(target/e), Kelly, caps); skip EV < min.
STRATEGY_SIZING=target_ev
STRATEGY_KAPPA=0.5
# Per-trade $ target = min(USD, share of the per-order risk budget) so it never caps size below the
# tier's limit; $ minimum = min(USD, fraction of bankroll). The spec's $10 / $1 apply at large bankrolls.
STRATEGY_TARGET_EV_USD=10
STRATEGY_TARGET_EV_OF_RISK=0.25
STRATEGY_MIN_TRADE_EV_USD=1
STRATEGY_MIN_TRADE_EV_FRAC=0.00016
# Veto entries when |p - p_mkt| < this many ensemble standard deviations.
STRATEGY_ENSEMBLE_VETO_SIGMAS=2
# Resting quotes expire on the exchange this long after they were placed (dead-man switch); one still wanted is placed
# again (each refresh is a new order, inside RISK_MAX_ORDERS_PER_MIN). Quotes are pulled when the index moves more than
# STRATEGY_FAST_MOVE_SIGMAS sigmas in 5 s.
STRATEGY_ORDER_TTL_SEC=20
STRATEGY_FAST_MOVE_SIGMAS=2
# Exit policy: confluence_ratchet (default: sell for profit once the bid beats the model's value, and
# let winners run on the order-book ratchet while confluence agrees), fair_value (model exit only),
# take_profit (resting maker take-profit at entry + STRATEGY_TAKE_PROFIT, plus the model exit), or
# hold (ride to settlement, no exit fee). Compare with
# research:backtest --exits hold,take_profit,fair_value,confluence_ratchet on real recordings.
EXIT_POLICY=confluence_ratchet
STRATEGY_TAKE_PROFIT=0.08
# Model exit: sell at the bid when bid - taker fee > q_adj + this margin.
STRATEGY_EXIT_MARGIN=0.01
# Take-profit: winners run, with a floor locked in. The floor is PROFIT_TARGET_PCT of what a contract cost (price plus
# entry fee) and at least PROFIT_TARGET_CENTS a contract, net of the entry's fees and the exit's taker fee (both 0 = off).
# Once selling would bank the floor the position is armed; it is sold at the touch when the gain falls back by
# PROFIT_GIVE_BACK of its best since the position was opened (a third), or into the last tick above the floor, never
# below it, whatever the model thinks the contract is worth. PROFIT_GIVE_BACK=0 sells as soon as the floor is reached.
# Give-back sales above the floor's last tick wait for the exit curve (SINUOUS_EXIT=gate).
PROFIT_TARGET_PCT=0.10
PROFIT_TARGET_CENTS=2
PROFIT_GIVE_BACK=0.33
# Hunt mode never starts in twilight (US close -> Asia open) or weekend liquidity, or within
# HUNT_TRANSITION_BUFFER_MIN of a session change; an active hunt reverts to the fair-value exit.
HUNT_SESSION_GUARD=true
HUNT_TRANSITION_BUFFER_MIN=10
HUNT_TARGET_MARGIN=0.02
HUNT_MIN_CONFLUENCE=2
RATCHET_MIN_FILL_RATIO=1
RATCHET_MIN_WALL_AGE_SEC=3
RATCHET_SLIPPAGE_TICKS=1

# ---- Kalshi perpetuals ---------------------------------------------------------
# Stage 1: public perp market data (premium to the settlement index, funding, open interest)
# recorded and used as model features. Works without a perps key.
PERPS_FEED=true
PERPS_POLL_MS=2000
# Defaults to demo/prod with KALSHI_ENV. Without a perps key the main Kalshi key (KALSHI_KEY_ID) is used:
# the perps REST API uses the same authentication (separate keys are only required for FIX).
KALSHI_PERPS_REST_URL=
KALSHI_PERPS_KEY_ID=
KALSHI_PERPS_PRIVATE_KEY_PATH=
KALSHI_PERPS_SUBACCOUNT=
# Stage 2: delta-hedge the binary book. off | paper (simulate against live perp quotes, default) |
# live (real perp orders; needs TRADING_MODE=live, perps keys, and a funded margin account).
PERP_HEDGE=paper
# Hedge only when the book's dollar delta ($ P&L of a 100% move; $2,000 = $20 per 1%) is at least this.
PERP_HEDGE_MIN_DOLLAR_DELTA=2000
# Per-asset cap on hedge notional (keeps margin use bounded; the hedge never exceeds the exposure).
PERP_HEDGE_MAX_NOTIONAL_USD=1000
# Contracts this close to settlement are excluded (unstable delta).
PERP_HEDGE_EXCLUDE_TAU_SEC=120
PERP_HEDGE_REPRICE_SEC=30
# A hedge REDUCTION unfilled this long crosses the spread (reduce-only), e.g. after the binaries settle.
PERP_HEDGE_TAKER_AFTER_SEC=300
PERP_MAKER_FEE_BPS=5
PERP_TAKER_FEE_BPS=12
# Stage 3 LIVE directional perp trading: off | paper | live (live needs TRADING_MODE=live + perps keys;
# PERP_HEDGE and PERP_TRADING share one account, so both live or both paper). Until params/perp_model.json
# passes research:perp-train AND research:perp-backtest --annotate, trading is capped at pilot size.
PERP_TRADING=paper
PERP_MODEL_PATH=./params/perp_model.json
PERP_PAPER_BALANCE_USD=100
PERP_HORIZON_MIN=240
PERP_ENTRY_EDGE_BPS=5
PERP_EXIT_EDGE_BPS=0
PERP_KELLY_FRACTION=0.25
PERP_MAX_LEVERAGE=3
PERP_MAX_NOTIONAL_USD=500
PERP_MAX_TOTAL_NOTIONAL_USD=1000
# Exchange-side stop: max(ATR mult x 1h ATR, min bps) from the entry; leverage <= 0.5 / stop distance.
PERP_STOP_ATR_MULT=2
PERP_MIN_STOP_BPS=50
PERP_MAX_HOLD_MIN=480
PERP_DAILY_LOSS_FRAC=0.10
PERP_COOLDOWN_MIN=60
PERP_PILOT_MAX_NOTIONAL_USD=25
PERP_PILOT_MAX_LEVERAGE=1
PERP_PRIOR_IC=0.05
PERP_REQUIRE_VALIDATION=false
PERP_MIN_EQUITY_USD=5
PERP_MAX_ORDER_NOTIONAL_USD=1000
PERP_COLLAR_BPS=150
# Liquidation beyond the stop (bot/risk/liquidation.ts): every perp entry is sized so the stop uses at most
# (1 - PERP_LIQ_BUFFER) of the room to liquidation, after the other open positions' stop losses and
# maintenance margin; open trades are cut when the exchange's estimate drifts inside that. PERP_MAINT_MARGIN
# 0 = half the initial margin implied by the exchange's leverage estimate (else 5%).
PERP_LIQ_BUFFER=0.2
PERP_MAINT_MARGIN=0
# The 4h ATR ratchet exit for setup trades (docs/SETUPS.md): off | slow | fast | both. Recorded in the setup
# model at training, so live trades are managed exactly as trained. Stop 3.5 ATR(4h); break-even plus fees
# after 2 ATR; from 3.5 ATR, trail 3 ATR behind the best price. Only ever tightens.
SETUP_RATCHET=slow
# SETUP_RATCHET_STOP_ATR=3.5
# SETUP_RATCHET_BE_ATR=2
# SETUP_RATCHET_TRAIL_START_ATR=3.5
# SETUP_RATCHET_TRAIL_ATR=3
# Unit = ATR(4h) x exp(k x the TA network's 4h vol forecast), clamped 0.67-1.5x; 0 = ATR(4h) alone (sweep: setups-ratchet).
# SETUP_RATCHET_VOL_K=0
# Scale-out exits (partial take-profits at R multiples, the rest trailed): off until the setups-scale sweep proves them.
# SETUP_SCALE_OUT=off
# SETUP_SCALE_R1=1
# SETUP_SCALE_F1=0.33
# SETUP_SCALE_R2=2
# SETUP_SCALE_F2=0.33
# SETUP_SCALE_TRAIL_ATR=2.5
# Spot pullback setups for the coins where Coinbase spot leads the Kalshi perp (weekly lead_lag study); off until the
# setups-spotpb sweep proves them.
# SETUP_SPOT_PB=off

# ---- Fractal Alignment Engine + waterfall mode (docs/FRACTAL.md) ---------------------------
# The 2018-to-now BTC.D cycle (child) aligned to its 2016-2017 parent. Waterfall mode can be armed on the
# dashboard only after BTC.D's first close at or below WATERFALL_GATE; armed: tennis paused, Kalshi binaries
# held to WATERFALL_KALSHI_MAX_FRAC of the bank; triggered (gate + fractal + USDT.D breakdown or SHIB volume
# velocity): Kalshi binaries paused, perps alt longs x ALT_LONG_MULT, alt shorts off, BTC x BTC_MULT.
# FAE_PARENT_FROM=2016-01-01
# FAE_PARENT_TO=2018-01-01
# FAE_CHILD_FROM=2018-01-01
WATERFALL_GATE=55
# WATERFALL_MIN_FIT=0.8
# WATERFALL_LEAD_WEEKS=8
# WATERFALL_SHIB_VELOCITY=2
WATERFALL_KALSHI_MAX_FRAC=0.125
WATERFALL_ALT_LONG_MULT=1.5
WATERFALL_BTC_MULT=0.5
# WATERFALL_LOW_BUFFER_PTS=3

# ---- Automated training + hot-swap (docs/AUTOMATION.md) ------------------------------
# daily: run the whole pipeline (dataset -> MLP -> backtest -> vol -> perps -> SNN ablation/train against
# that MLP) every day at AUTO_TRAIN_HOUR_UTC and hot-swap the results; off: no schedule (swaps still work).
# windows (default): once a day, but only inside the session-edge windows (first/last SESSION_EDGE_MIN
# minutes of the Asia, London and New York sessions), frozen outside them and resumed at the next one,
# so training never runs while the bot trades. daily: at AUTO_TRAIN_HOUR_UTC, unpaused.
AUTO_TRAIN=windows
AUTO_TRAIN_HOUR_UTC=6
# Session edges: no new entries in them (exits still run); also the training windows.
SESSION_EDGE_MIN=40
SESSION_EDGE_NO_ENTRY=true
# always = hot-swap every freshly trained model; validated = only models that passed their gates.
AUTO_TRAIN_PROMOTE=always
AUTO_TRAIN_SNN_STAGE=auto
AUTO_TRAIN_ABLATION_DAYS=7
AUTO_TRAIN_ABLATION_EVERY_DAYS=7
AUTO_TRAIN_SNN_TRAIN_DAYS=21
AUTO_TRAIN_ON_MODEL_CHANGE=true
# Skip retrain steps whose inputs did not change since their last run (docs/AUTOMATION.md).
AUTO_TRAIN_SKIP_UNCHANGED=true
AUTO_TRAIN_MIN_DAYS=1
# Rows the Kalshi MLP trains on; over it each contract's snapshots are thinned evenly (0 = no limit).
# DATASET_MAX_ROWS=200000
# AUTO_TRAIN_DIR=./data/models
# AUTO_TRAIN_RECORDINGS=./data/recordings
AUTO_TRAIN_WATCH_SEC=30
# Recordings: gzip days older than this (0 = never; every reader handles both forms) and alert when
# free disk drops below this many GB. Nothing is deleted automatically.
RECORDINGS_GZIP_AFTER_DAYS=2
RECORDINGS_MIN_FREE_GB=3
# Sweep optimizer targets (weekly, proposals only): bot = the whole bot over the recordings.
SWEEP_TARGETS=setups-long,setups-short,setups-vol,setups-ratchet,setups-scale,setups-spotpb,kalshi,bot
# The Kalshi and whole-bot sweeps run on the most recent this many days; their model-call tapes (recorded on a
# window's first backtest, played back on the rest) are kept within this many GB.
SWEEP_KALSHI_DAYS=60
SWEEP_TAPE_GB=4
# TradingView (tvdatafeed, deploy/tv_history.py) in the daily history step: 5,000 bars of BTC.D, USDT.D,
# TOTAL3, OTHERS.D and RTY (US Russell 2000), their daily refresh, and filling holes in every coin's
# candles (stored as source tvspot: gaps only, never replacing an exchange's own bars).
TV_FILL=true
# Indicator engine: TA-Lib (vendor/talib, built on npm ci) is the default; builtin forces the fallback.
# TA_ENGINE=builtin
# TA network layout: flat, or grouped (indicator families -> family encoders -> GRU / context + family attention).
TA_NET_ARCH=flat
# Time budget per run for the TA network's walk-forward export (feeds the setup scorer; resumes).
TA_NET_OOS_HOURS=3
# The walking TA network the setup trader reads until the pipeline promotes data/models/ta_net_wf.json.
# SETUP_TA_NET_PATH=./params/ta_net_wf.json
# The Librarian (oracle strategy + regime-transition heads on the TA network's inputs) until the pipeline promotes
# data/models/librarian.json.
# LIBRARIAN_PATH=./params/librarian.json
# The oracle cull (research/oracleCull.ts, weekly pipeline step oracle_cull): TA readings that tell nothing about the
# hindsight-best strategy are switched off in the TA network and the Librarian. ORACLE_CULL_LEVEL=unproven culls every
# reading not proven (default noise: only readings that forecast the oracle worse than not reading them).
# ORACLE_CULL=true
# ORACLE_CULL_LEVEL=noise
# The Compensator (research/compensator.ts, built in the playbook step): per strategy (Kalshi, each perps setup kind), a
# learned ramp of its weight on the coin's Librarian reading; replaces the playbook's weight when it beat both the static
# bot and the playbook on later replay days. COMPENSATOR=false skips fitting it; COMPENSATOR_APPLY=false ignores it live.
# COMPENSATOR=true
# COMPENSATOR_APPLY=true
# The cross-asset graph network on relative returns until the pipeline promotes data/models/cross_graph.json, and its
# training engine (ts | torch | auto: PyTorch when a Python with it and numpy is found).
# CROSS_GRAPH_PATH=./params/cross_graph.json
# Cross-coin lead-lag study (research/crossLead.ts; the pipeline's data/models/cross_lead.json is preferred).
# CROSS_LEAD_PATH=./params/cross_lead.json
# XG_ENGINE=auto
# The Kalshi and tennis MLPs: PyTorch when a Python with it starts (MLP_PYTHON, else TA_NET_PYTHON), else TypeScript (research/mlpTorch.ts).
# MLP_ENGINE=auto
# SNN tournaments and contests: each span's inputs are recorded once (work/snn-tape) and every member plays them (research/snnTape.ts).
# SNN_TAPES=true
# SNN_TAPE_CACHE_GB=10
# SNN columns step in WebAssembly (bot/snn/kernel.ts; the same results, about twice as fast); false = TypeScript.
# SNN_WASM=true

# ---- Cortex-like SNN (bot/snn; docs/SNN.md) ----------------------------------------------
# off | shadow (runs 24/7, logs its direction calls, feeds the MLP/perps/tennis models; no blend) | blend (legacy: also blends p_snn into p_model with an earned alpha <= 0.25)
SNN_MODE=shadow
# Staging S0..S6 (S6 = online plasticity). Promote a stage only after research:snn-ablation accepts it.
SNN_STAGE=S5
# Whitelisted columns (asset-horizon), empty = the first SNN_MAX_COLUMNS seen. The SNN never adds assets.
SNN_COLUMNS=
SNN_MAX_COLUMNS=18
# Three isolated networks, one per contract type, each with its own worker, params, health and
# model file. They never read each other; each decision model reads only its own network:
# crypto (15m/1h, scored on settled contracts) -> MLP; perps (1h/4h, graded on direction) -> perps
# model; tennis (live only) -> tennis model.
SNN_CRYPTO=true
SNN_PERPS=true
SNN_TENNIS=true
# Per-network stage (default SNN_STAGE; tennis defaults to S3: no offline pretraining) and model file.
# SNN_CRYPTO_STAGE=S5
# SNN_PERPS_STAGE=S5
# SNN_TENNIS_STAGE=S3
SNN_CRYPTO_MODEL_PATH=./params/snn_crypto.json
SNN_PERPS_MODEL_PATH=./params/snn_perps.json
SNN_TENNIS_MODEL_PATH=./params/snn_tennis.json
# true lets the MLP read the perps network's 4h call and the perps model the crypto network's 15m
# call (only for horizons their own network lacks). Off keeps the networks fully separated.
SNN_CROSS_FEED=false
SNN_CHECKPOINT_EVERY_MIN=10
SNN_WORKER=true
# Decision deadline (<= 200 ms; on timeout alpha = 0) and the latency p99 above which the vote is skipped.
SNN_TIMEOUT_MS=200
SNN_LATENCY_SKIP_P99_MS=150
SNN_ALPHA_MAX=0.25
SNN_MIN_EVENTS=200
SNN_READOUT_ETA=0.0001
SNN_SEED=20260601
# Conservative-only target scaling (hunt take-profit distance x [0.85, 1], one step per 15 min; blend mode only).
SNN_TARGET_SCALING=true
# Deferred mechanisms (must beat their cheap proxies in the ablation first).
SNN_WILSON_COWAN=false
SNN_GAP_JUNCTIONS=false
SNN_IZHIKEVICH_CH=false
SNN_DCAAP=false

# ---- MLP take/skip head (meta-labeling on the SNN's direction) ---------------------------
# validated: once its held-out check passes, entries need P(win) >= break-even (price + fee) + TAKE_MARGIN.
TAKE_GATE=validated
TAKE_MARGIN=0

# ---- ATP tennis match-winner markets (bot/tennis) ------------------------------------
# Tracked and traded in paper/shadow. In TRADING_MODE=live tennis is tracking-only unless
# TENNIS_LIVE=true (enable only after `npm run research:tennis` shows an edge on recordings).
TENNIS_ENABLED=true
TENNIS_LIVE=false
TENNIS_SERIES=KXATPMATCH
TENNIS_HORIZON_HOURS=36
# Budget: all tennis positions + resting orders <= 25% of the working cash pool (hard max 25%);
# per match 10%, per order 5%.
TENNIS_MAX_TOTAL_FRAC=0.25
TENNIS_MAX_MATCH_FRAC=0.10
TENNIS_ORDER_FRAC=0.05
# Underdog bounce: within TENNIS_PRE_START_MIN before / TENNIS_ENTRY_WINDOW_MIN after the start, buy
# the underdog (maker) when it is priced TENNIS_UNDERDOG_MIN..MAX; take profit at
# max(entry + TP_CENTS, entry x (1 + TP_PCT)). Optional stop (0 = off, hold to settlement).
# The pre-start window is capped at 30 minutes (the edge is the early bounce, not a day-ahead bet).
# Full size before the start and for EARLY_FULL_SIZE_MIN after it, tapering to half size at
# ENTRY_WINDOW_MIN. Underdogs usually lose late: past UNDERDOG_LATE_PROGRESS of the match any
# profit is taken (no hunting); past UNDERDOG_CUT_PROGRESS the position is sold at the bid (0 = off).
TENNIS_UNDERDOG_MAX=0.25
TENNIS_UNDERDOG_MIN=0.08
TENNIS_PRE_START_MIN=30
TENNIS_ENTRY_WINDOW_MIN=20
TENNIS_MAX_SPREAD=0.03
TENNIS_TP_CENTS=0.06
TENNIS_TP_PCT=0.40
TENNIS_UNDERDOG_STOP_CENTS=0
TENNIS_EARLY_FULL_SIZE_MIN=10
TENNIS_UNDERDOG_LATE_PROGRESS=0.35
TENNIS_UNDERDOG_CUT_PROGRESS=0.6
# Tennis confluence (4 signals, measured over CONF_WINDOW_SEC): momentum = our mid up >= MOMENTUM_CENTS;
# flow = signed taker flow >= FLOW; depth = top-3 book imbalance >= DEPTH; opponent mid down
# >= OPPONENT_CENTS. Entries need ENTRY_MIN_SIGNALS_PRE of them before the start, _LIVE after it;
# the favorite re-entry needs FAV_ENTRY_MIN_SIGNALS.
TENNIS_CONF_WINDOW_SEC=60
TENNIS_CONF_MOMENTUM_CENTS=0.01
TENNIS_CONF_FLOW=0.2
TENNIS_CONF_DEPTH=0.2
TENNIS_CONF_OPPONENT_CENTS=0.01
TENNIS_ENTRY_MIN_SIGNALS_PRE=1
TENNIS_ENTRY_MIN_SIGNALS_LIVE=2
TENNIS_FAV_ENTRY_MIN_SIGNALS=2
# Favorite re-entry once the match is >= FAV_MIN_PROGRESS done and the leader is FAV_MIN..MAX and not
# slipping > FAV_STABLE_CENTS.
TENNIS_FAV_MIN=0.75
TENNIS_FAV_MAX=0.92
TENNIS_FAV_MIN_PROGRESS=0.5
TENNIS_FAV_STABLE_CENTS=0.04
TENNIS_FAV_STOP_CENTS=0
# Match progress (0..1) is measured in points by a tennis scoring model (deuce, 7-point tiebreaks,
# 10-point final-set tiebreak at the Slams, best of 3 / best of 5 at Slam main draws) calibrated to the
# pre-match price: point clock = minutes / SEC_PER_POINT vs the expected match length, blended at
# PROGRESS_INFO_WEIGHT with the information clock (share of the match's price uncertainty already
# resolved, sampled every QV_SAMPLE_SEC). SERVE_BASE: tour-average serve points won.
TENNIS_SEC_PER_POINT=40
TENNIS_SERVE_BASE=0.64
TENNIS_PROGRESS_INFO_WEIGHT=0.5
TENNIS_QV_SAMPLE_SEC=30
# Live score from Kalshi milestone live data (exact progress from sets/games/points). The tennis
# payload is undocumented: check scoreRaw in /api/status on a few matches before relying on it.
TENNIS_SCORE_FEED=off
TENNIS_SCORE_POLL_SEC=15
# Without a published start time, "in play" = a mid move of this size within 3 minutes.
TENNIS_LIVE_MOVE_CENTS=0.03
# Price hunt from the target (both legs; underdog target: the take-profit level above; favorite:
# min(FAV_TRAIL_CAP, entry + FAV_TRAIL_CENTS)). Stop starts AT the target and climbs to order-book walls
# that can fill the position. false = fixed maker take-profit.
TENNIS_TRAIL=true
TENNIS_FAV_TRAIL_CENTS=0.06
TENNIS_FAV_TRAIL_CAP=0.97
TENNIS_TRAIL_MIN_FILL_RATIO=1
TENNIS_TRAIL_MIN_WALL_AGE_SEC=3
TENNIS_TRAIL_SLIPPAGE_TICKS=1
# Conservative hunt past the target: continue only while >= MIN_SIGNALS of the tennis confluence
# signals agree (momentum, taker flow, book depth, opponent market falling), for at most MAX_SEC,
# trailing TRAIL_TICKS under the peak bid; then take the next available exit in profit.
TENNIS_HUNT_MIN_SIGNALS=2
TENNIS_HUNT_MAX_SEC=180
TENNIS_HUNT_TRAIL_TICKS=2

# ---- Risk (fractions of bankroll) ------------------------------------------
# Fat-finger ceiling; the bankroll fractions below bind first. Pilot at 10-20% size.
RISK_MAX_CONTRACTS_PER_ORDER=250
RISK_MAX_ORDER_FRAC=0.02
# Same-close BTC/ETH/SOL count as one correlated position.
RISK_MAX_WINDOW_FRAC=0.02
RISK_MAX_TOTAL_FRAC=0.10
RISK_DAILY_LOSS_FRAC=0.03
# Kelly x max(0, 1 - drawdown / RISK_DD_SCALE_AT); 24 h pause after a 7-day loss beyond RISK_WEEKLY_LOSS_PAUSE.
RISK_DD_SCALE_AT=0.15
RISK_WEEKLY_LOSS_PAUSE=0.08
# Halt new risk when live log loss is significantly worse than the calibrated market (>= N windows).
MODEL_HEALTH_HALT=true
MODEL_HEALTH_MIN_WINDOWS=200
# Dollar ceiling on the daily stop at the $100 (normal) tier; smaller tiers have their own ($4, $5) and
# above $100 it grows with the account (see README, sizing tiers).
RISK_DAILY_LOSS_USD=5
RISK_MIN_SIDE_PRICE=0.10

# ---- Market sessions --------------------------------------------------------------
# Reduce-only per-session multipliers. Keys: asia, london, london_ny_overlap, new_york,
# twilight, weekend, us_open (first 30 min after the NYSE open). Values: sizeMult [0,1],
# minEdgeAdd [0,0.2], skewMult [0,5]. Get evidence-based values from research:sessions.
SESSION_RISK=
# Intraday volatility profile for fair value. Applied only if the file's out-of-sample
# validation improved accuracy (npm run research:sessions writes and validates it).
VOL_SEASONALITY=true
VOL_PROFILE_PATH=./params/vol_profile.json
# Tree volatility forecast (research:vol-model): multiplies fair value's sigma by
# clamp(exp(prediction), 0.5, 2). Applied only when its held-out QLIKE check passed.
VOL_MODEL=true
VOL_MODEL_PATH=./params/vol_model.json
# Until a validated vol forecast is in use, fair value's sigma is multiplied by this (1 = off). The 5-minute EWMA lags
# on volatile days; 1.15 scored best on the Oct 20-22 live log loss (1.3 helped Oct 21-22 but hurt Oct 20).
VOL_FALLBACK_MULT=1.15
# Fill / adverse-selection model (research:fill-train). Every maker entry quote is logged to
# data/fills; once >= 500 quotes and >= 100 fills exist the pipeline trains it, promotes it only
# when it beats the base rate on held-out days, and the bot starts using it on its own: per maker
# entry it quotes, crosses or skips by expected value. FILL_MIN_EV = minimum EV per contract ($).
FILL_MODEL_PATH=./params/fill_model.json
FILL_MIN_EV=0

# ---- Profit vault / pocket (bookkeeping: reserved cash is simply not traded) -------
# 50% of each win is vaulted until VAULT_QUOTA_USD is met; vaulting then pauses until the
# next market session opens (VAULT_QUOTA_RESET=session) or the next US open (=us_open).
# While the quota is met, 10% of each win is pocketed and released at the next US open.
# Withdrawals from Kalshi are detected from the balance and come out of the vault first.
VAULT_ENABLED=true
VAULT_QUOTA_USD=100
VAULT_WIN_SHARE=0.5
POCKET_SHARE=0.1
VAULT_QUOTA_RESET=session
# Headline goal per trading day (US open to US open); per-session refills can exceed it.
VAULT_DAILY_GOAL_USD=100
# Graduation ramp: a small account must compound to reach the bigger sizing tiers, so the vault and
# pocket shares scale from 0 at the tradable high-water mark RAMP_START (the $20 tier) to full at
# RAMP_FULL (the $100 tier), linear in log(bankroll). VAULT_RAMP_FULL_USD=0 turns the ramp off.
VAULT_RAMP_START_USD=20
VAULT_RAMP_FULL_USD=100

# ---- Alerts ---------------------------------------------------------------------
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ---- Live Tennis API scores + tennis MLP ---------------------------------------------
# Free tier: 30 requests/min, 100/day; one slate call covers every live match.
# Setting the key switches TENNIS_SCORE_FEED to livetennis (or set it explicitly: off | kalshi | livetennis).
# LIVE_TENNIS_API_KEY=
# TENNIS_SCORE_FEED=livetennis
# Refresh a match's score after this many minutes even without a price move.
TENNIS_SCORE_IDLE_MIN=30
# Tennis MLP: when validated, entries need fair P(win) - price >= this.
TENNIS_FAIR_MIN_EDGE=0.01
# TENNIS_MODEL_PATH=./params/tennis_model.json
