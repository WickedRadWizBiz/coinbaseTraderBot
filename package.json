{
  "name": "kalshi-crypto15m-bot",
  "private": true,
  "version": "2.0.0",
  "description": "Kalshi 15-minute crypto trading bot: digital-option fair value, fail-closed risk gateway, OMS with reconciliation.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx bot/main.ts",
    "start": "node dist/bot.cjs",
    "build": "npm run build:web && npm run build:bot",
    "build:bot": "esbuild bot/main.ts --platform=node --target=node20 --bundle --format=cjs --outfile=dist/bot.cjs --packages=external && esbuild bot/snn/worker.ts --platform=node --target=node20 --bundle --format=cjs --outfile=dist/snnWorker.cjs --packages=external",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "research:dataset": "tsx research/buildDataset.ts",
    "research:train": "tsx research/trainMetaModel.ts",
    "research:backtest": "tsx research/backtest.ts",
    "research:sessions": "tsx research/sessions.ts",
    "research:tennis": "tsx research/tennisBacktest.ts",
    "research:ta": "tsx research/taStudy.ts",
    "research:perp-train": "tsx research/trainPerpModel.ts",
    "research:perp-backtest": "tsx research/perpBacktest.ts",
    "research:snn-train": "tsx research/trainSnn.ts",
    "research:snn-ablation": "tsx research/snnAblation.ts",
    "research:snn-golden": "python3 research/snn_reference.py",
    "ta:docs": "tsx scripts/taLibraryDoc.ts",
    "audit:verify": "tsx scripts/verifyAudit.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
